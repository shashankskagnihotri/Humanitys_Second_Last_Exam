# Copy this file to .env and fill only the providers you use.
# Never commit .env or paste credentials into YAML, Python, notebooks, or logs.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
OPENROUTER_API_KEY=

# Helix local generation reads the Gemini credential from this protected
# user-owned file. Export this path before invoking a Helix entry script.
HSLE_GEMINI_KEY_FILE=

# Separately hosted Hugging Face dataset location. These are configuration
# values, not credentials. Pin the exact revision used for a replication.
HSLE_DATASET_REPO=shashankskagnihotri/humanitys-second-last-exam
HSLE_DATASET_REVISION=aeda08b2536a19e698d027fd4f701eea78c9171d

# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Humanitys-Second-Last-Exam
